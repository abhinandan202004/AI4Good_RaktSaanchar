# =============================================================================
# RaktSaanchar — Production Frontend Dockerfile
# Multi-stage: Stage 1 builds the Vite bundle, Stage 2 serves it via Nginx.
# =============================================================================

# ── Stage 1: Build ─────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Install deps first (better Docker layer caching)
COPY package*.json ./
RUN npm install --legacy-peer-deps

# Copy source
COPY . .

# Build-time Vite env vars (passed as --build-arg in docker compose)
ARG VITE_API_BASE_URL
ARG VITE_WS_URL
ARG VITE_NTFY_BASE_URL
ARG VITE_NTFY_TOPIC_PREFIX

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_WS_URL=$VITE_WS_URL
ENV VITE_NTFY_BASE_URL=$VITE_NTFY_BASE_URL
ENV VITE_NTFY_TOPIC_PREFIX=$VITE_NTFY_TOPIC_PREFIX

RUN npm run build

# ── Stage 2: Serve ─────────────────────────────────────────────────────────
FROM nginx:alpine

# Copy the built React app
COPY --from=builder /app/dist /usr/share/nginx/html

# SPA routing config (try_files → index.html fallback)
COPY nginx-spa.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
