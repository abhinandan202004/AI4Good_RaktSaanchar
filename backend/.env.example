# RaktaSanchaar API Configuration Example
# Copy this file to .env and configure your variables

APP_NAME="RaktaSanchaar API"
APP_VERSION="1.0.0"
DEBUG=True

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=raktasanchaar
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/raktasanchaar

# Redis Configuration
REDIS_URL=redis://redis:6379

# Security Configuration
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ML Service Integration URL
ML_SERVICE_URL=http://ml-service:8002

# Chatbot Service Integration URL
CHATBOT_SERVICE_URL=http://chatbot:8001
