# =============================================================================
# RaktSaanchar — Microservices .env.example
# Copy this file to .env and fill in your actual values.
# =============================================================================

# ── Shared JWT secret (ALL services MUST share this value) ───────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-use-a-very-long-random-string-at-least-32-chars

# ── Email (Gmail SMTP — free, 500 emails/day) ─────────────────────────────────
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Go to: Google Account → Security → App Passwords
# 3. Generate a 16-character App Password (NOT your Gmail account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx    # 16-char Gmail App Password

# Alternative: Brevo (formerly Sendinblue) — 300 emails/day free, no credit card
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login@email.com
# SMTP_PASS=your-brevo-smtp-key

# ── ntfy.sh Push Notifications (free, no account needed) ─────────────────────
# Public hosted: https://ntfy.sh  (no account, but topics are public)
# Self-hosted:   http://ntfy:80   (use with the ntfy container in compose)
NTFY_BASE_URL=https://ntfy.sh
# Use a unique prefix per environment to avoid topic collisions
NTFY_TOPIC_PREFIX=raktsaanchar-prod

# ── AI APIs ───────────────────────────────────────────────────────────────────
MISTRAL_API_KEY=your-mistral-api-key
SARVAM_API_KEY=your-sarvam-api-key

# ── RabbitMQ (set in docker-compose but can be overridden) ───────────────────
RABBITMQ_USER=rakt
RABBITMQ_PASS=rakt

# ── Removed AWS variables (no longer needed) ─────────────────────────────────
# AWS_ACCESS_KEY_ID     — REMOVED (was used for SES/SNS)
# AWS_SECRET_ACCESS_KEY — REMOVED
# AWS_REGION            — REMOVED
# AWS_SNS_TOPIC_ARN     — REMOVED
# AWS_SNS_ENABLED       — REMOVED
# AWS_SES_SENDER        — REMOVED
